{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raasta-api",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Replace the TODO ids after creating the resources (wrangler kv namespace create / d1 create).
  "kv_namespaces": [{ "binding": "CACHE", "id": "7ca18a9f77bc40b08ba2790909cefb2a" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "raasta-db", "database_id": "45666e7c-0369-4fa5-b19b-60a9eb0a5f1d", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "FORM_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "TRANSLATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "https://raasta.safalmutha.in,http://localhost:5173,http://localhost:8787",
    "AI_PRIMARY": "gemini",
    "OSM_USER_AGENT": "Raasta/1.0 (hackathon project)"
  }
  // Enable at deploy time (zone safalmutha.in is on Cloudflare):
  // "routes": [
  //   { "pattern": "raasta.safalmutha.in/api/*", "zone_name": "safalmutha.in" },
  //   { "pattern": "raasta.safalmutha.in/r/*", "zone_name": "safalmutha.in" }
  // ]
}
