{
  "name": "@raasta/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/guard-dist.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "browserslist": [
    "defaults",
    "Chrome >= 61",
    "Safari >= 12",
    "Samsung >= 8",
    "Firefox ESR",
    "not dead"
  ],
  "dependencies": {
    "@raasta/config": "*",
    "@raasta/i18n": "*",
    "@raasta/rules": "*",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-react": "^6.3.0",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.4",
    "vite": "^8.3.8"
  }
}
