{
  "name": "raasta",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @raasta/web",
    "dev:api": "npm run dev -w @raasta/api",
    "build": "npm run build -w @raasta/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ingest": "node scripts/ingest.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "zod": "^3.24.0",
    "@types/node": "^22.10.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
