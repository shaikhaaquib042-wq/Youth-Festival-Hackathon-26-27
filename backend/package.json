{
  "name": "sunshield-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": { "effect": "3.22.1" },
  "engines": { "node": ">=24 <25" },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm --prefix .. run build:infrastructure && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "npm --prefix .. run build:infrastructure && tsc --noEmit",
    "test": "vitest run"
