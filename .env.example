# Raasta environment. Copy to .env (git-ignored), fill what you have, then run: node scripts/env-sync.mjs
# Everything is optional: the app works with no keys (guided flow, keyword intake, public OSRM, source text for translation).

# AI: Anthropic key, only if you want it (paid, never required)
ANTHROPIC_API_KEY=
# AI: Google Gemini free tier key (aistudio.google.com)
GEMINI_API_KEY=
# AI: key for an OpenAI-compatible provider, e.g. a Groq or OpenRouter free model
OPENAI_API_KEY=
# AI: base URL of the OpenAI-compatible provider, e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# AI: local Ollama for development only (the Worker refuses non-localhost hosts)
OLLAMA_URL=http://localhost:11434
# AI: which provider to try first: gemini | workers | openai | anthropic | ollama (keep a free one first)
AI_PRIMARY=gemini

# Translation: BHASHINI user id from bhashini.gov.in onboarding
BHASHINI_USER_ID=
# Translation: BHASHINI ULCA API key
BHASHINI_ULCA_API_KEY=
# Translation: BHASHINI pipeline id (published reference id, confirm in your dashboard)
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# Translation: optional self-hosted LibreTranslate URL
LIBRETRANSLATE_URL=

# DIGIT/UPYOG: base URL of the PGR gateway (leave empty to use the built-in demo mock)
DIGIT_BASE_URL=
# DIGIT/UPYOG: tenant id of the ULB, e.g. the sandbox tenant
DIGIT_TENANT_ID=
# DIGIT/UPYOG: OAuth client id for citizen tokens
DIGIT_CLIENT_ID=
# DIGIT/UPYOG: OAuth client secret
DIGIT_CLIENT_SECRET=
# DIGIT/UPYOG: citizen UI base URL used for the "See your complaint" link
DIGIT_CITIZEN_UI_URL=

# OpenStreetMap: raster tile URL for the opt-in Leaflet map (free, attribution required)
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# OpenStreetMap: Nominatim geocoder base URL
NOMINATIM_URL=https://nominatim.openstreetmap.org
# OpenStreetMap: routing provider for directions: ors | graphhopper | osrm
OSM_ROUTING_PROVIDER=ors
# OpenStreetMap: OpenRouteService or GraphHopper key (leave empty to use OSRM)
OSM_ROUTING_API_KEY=
# OpenStreetMap: OSRM base URL (works with no key)
OSRM_URL=https://router.project-osrm.org
# OpenStreetMap: User-Agent sent to Nominatim and Overpass (include a contact if you can)
OSM_USER_AGENT=Raasta/1.0 (hackathon project)

# Security: Cloudflare Turnstile secret (server side); forms skip the check when empty
TURNSTILE_SECRET_KEY=
# Security: Turnstile site key (public, safe in the browser)
VITE_TURNSTILE_SITE_KEY=
# Security: comma separated origins allowed to POST (Origin/Referer check)
ALLOWED_ORIGINS=https://raasta.safalmutha.in,http://localhost:5173
# Security: HMAC key for signed route-result tokens (use a long random string)
TOKEN_SECRET=

# Web: public site URL used for canonical links (the API is same-origin under /api)
VITE_SITE_URL=https://raasta.safalmutha.in

# Optional overrides (defaults are in code)
# Gemini model name (default gemini-2.5-flash)
GEMINI_MODEL=
# Model name for the OpenAI-compatible provider
OPENAI_MODEL=
# Overpass interpreter URL for the non-Maharashtra office fallback
OVERPASS_URL=
